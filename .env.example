# OpenAI API 配置
# 复制此文件为 .env.local 并填入你的配置

# OpenAI API Key
VITE_OPENAI_API_KEY=your-api-key-here

# OpenAI API Base URL
# 开发环境使用代理地址，生产环境可改为实际的 API 地址
# 支持第三方兼容 OpenAI 格式的 API
VITE_OPENAI_API_BASE_URL=/api/openai/v3/openai

# OpenAI Model
# 指定使用的模型，如 gpt-4o-mini, gpt-4, zai-org/glm-5 等
VITE_OPENAI_API_MODEL=
